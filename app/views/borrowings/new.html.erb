<section class="container">
  <h1>Borrow a Book</h1>

  <%= form_with(model: @borrowing, local: true) do |form| %>
    <div class="form-group">
      <%= form.label :book_id, 'Select a Book' %>
      <%= form.collection_select :book_id, Book.where(available: true), :id, :title, prompt: 'Choose a book', class: 'form-control' %>
    </div>

    <div class="form-group mt-4">
      <%= form.submit 'Borrow Book', class: 'btn btn-primary' %>
    </div>
  <% end %>
</section>