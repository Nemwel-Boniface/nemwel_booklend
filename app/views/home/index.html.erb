<!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <h1>Welcome to My Book Lending App</h1>
      <p>Discover, borrow, and enjoy a vast collection of books at your fingertips.</p>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section">
    <div class="container">
      <div class="row">
        <div class="col-md-4">
          <div class="card">
            <img src="https://images.unsplash.com/photo-1482304651556-cb27a6fb596a?w=400&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8N3x8YnJvd3NlJTIwYm9va3N8ZW58MHx8MHx8fDA%3D" class="card-img-top" alt="Browse Books">
            <div class="card-body">
              <h5 class="card-title">Browse Books</h5>
              <p class="card-text">Explore our extensive library and find your next read.</p>
              <%= link_to 'Browse now', books_path, class: 'btn btn-primary' %>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card">
            <img src="https://images.unsplash.com/photo-1535905557558-afc4877a26fc?w=400&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTl8fGJvcnJvdyUyMGElMjBib29rfGVufDB8fDB8fHww" class="card-img-top" alt="Borrow Books">
            <div class="card-body">
              <h5 class="card-title">Borrow Books</h5>
              <p class="card-text">Easily borrow books with a click and enjoy reading.</p>
              <%= link_to 'Borrow book', borrowings_path, class: 'btn btn-primary' %>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card">
            <img src="https://images.unsplash.com/photo-1622673038079-de1ddac26c16?q=80&w=1287&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="card-img-top" alt="Your Borrowed Books">
            <div class="card-body">
              <h5 class="card-title">Your Borrowed Books</h5>
              <p class="card-text">Keep track of the books you've borrowed and their due dates.</p>
              <%= link_to 'View Your Books', borrowings_path, class: 'btn btn-primary' %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# Books section %>
<section class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Explore Books</h2>
    <%= link_to 'See all books', books_path, class: 'btn btn-primary' %>
  </div>
  <div class="row">
    <% if @books.empty? %>
      <div class="col-12">
        <h5>There are no books available at the moment. Please check back later.</h5>
      </div>
    <% else %>
      <% @books.each do |book| %>
        <div class="col-12 col-sm-6 col-lg-3 mb-4">
          <div class="card h-100">
            <% if book.cover_photo.present? %>
              <%= image_tag book.cover_photo, class: 'card-img-top', alt: "#{book.title} cover" %>
            <% else %>
              <%= image_tag 'https://images.unsplash.com/photo-1512820790803-83ca734da794?q=80&w=1498&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D', class: 'card-img-top', alt: 'Default cover' %>
            <% end %>
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= book.title %></h5>
              <p class="card-text"><strong>Author:</strong> <%= book.author %></p>
              <p class="card-text"><strong>ISBN:</strong> <%= book.isbn %></p>
              <%= link_to 'View Details', book_path(book), class: 'btn btn-outline-primary mt-auto' %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

